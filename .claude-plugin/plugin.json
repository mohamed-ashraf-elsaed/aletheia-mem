{
  "name": "aletheia-mem",
  "displayName": "Aletheia Memory",
  "version": "0.1.0",
  "description": "Local memory and rules hub for AI coding tools, exposed over MCP.",
  "author": {
    "name": "Mohamed Ashraf Elsaed"
  },
  "homepage": "https://mohamed-ashraf-elsaed.github.io/aletheia-mem/",
  "repository": "https://github.com/mohamed-ashraf-elsaed/aletheia-mem",
  "license": "Apache-2.0",
  "keywords": ["memory", "mcp", "rules", "local-first"],
  "x-aletheia-verification": "from-docs-only",
  "mcpServers": {
    "aletheia": {
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mcp.mjs"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/aletheia.mjs hook claude-code SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/aletheia.mjs hook claude-code Stop"
          }
        ]
      }
    ]
  }
}
