{
  "name": "aletheia-mem",
  "version": "0.1.0",
  "description": "Local memory and rules hub for AI coding tools, exposed over MCP.",
  "x-aletheia-verification": "from-docs-only",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/bin/aletheia.mjs\" hook codex SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/bin/aletheia.mjs\" hook codex Stop"
          }
        ]
      }
    ]
  }
}
